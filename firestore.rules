rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required, immutable) - User ID
    //   - email: string (required) - User email
    //   - displayName: string (optional) - User display name
    //
    // Collection: users/{userId}/savedTimers
    // Document ID: {timerId}
    // Fields:
    //   - uid: string (required, immutable) - User ID
    //   - name: string (required) - Timer name
    //   - duration: number (required) - Duration in seconds
    //   - activity: string (required) - Activity type
    //   - method: string (optional) - Productivity method
    //
    // Collection: users/{userId}/sessions
    // Document ID: {sessionId}
    // Fields:
    //   - uid: string (required, immutable) - User ID
    //   - duration: number (required) - Duration in seconds
    //   - activity: string (required) - Activity type
    //   - timestamp: string (required, format: date-time) - Session timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function uidNotModified(oldData) {
      return request.resource.data.uid == oldData.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return data.uid is string && data.email is string &&
             (!('displayName' in data) || data.displayName is string);
    }

    function isValidSavedTimer(data) {
      return data.uid is string && data.name is string && data.duration is number && data.activity is string &&
             (!('method' in data) || data.method is string);
    }

    function isValidSession(data) {
      return data.uid is string && data.duration is number && data.activity is string && data.timestamp is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified(resource.data);

      match /savedTimers/{timerId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSavedTimer(request.resource.data) && request.resource.data.uid == userId;
        allow update: if isOwner(userId) && isValidSavedTimer(request.resource.data) && uidNotModified(resource.data);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSession(request.resource.data) && request.resource.data.uid == userId;
        allow update: if false; // Sessions are immutable
        allow delete: if isOwner(userId);
      }
    }
  }
}
